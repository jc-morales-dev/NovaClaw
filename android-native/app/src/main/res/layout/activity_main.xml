<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0A08">

    <!-- Pantalla de preparación (solo se ve mientras la app se prepara sola) -->
    <ScrollView
        android:id="@+id/setupRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="96dp"
            android:paddingBottom="32dp">

            <View
                android:id="@+id/orb"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:background="@drawable/bg_orb"
                android:layout_marginBottom="28dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#FF7A1A"
                android:textSize="34sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tu agente de código, dentro del teléfono"
                android:textColor="#A89A8C"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:indeterminateTint="#FF7A1A"
                android:layout_marginTop="44dp" />

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preparando el entorno…"
                android:textColor="#E8D9C5"
                android:textSize="14sp"
                android:layout_marginTop="14dp" />

            <TextView
                android:id="@+id/txtHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="La primera vez se descarga todo lo necesario.\nPuede tardar unos minutos."
                android:textColor="#6E6053"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnRetry"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Reintentar"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#1A0E02"
                app:backgroundTint="#FF7A1A"
                app:cornerRadius="16dp"
                android:layout_marginTop="28dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver detalles"
                android:textColor="#8A7C6E"
                android:textSize="12sp"
                android:padding="10dp"
                android:layout_marginTop="20dp" />

            <ScrollView
                android:id="@+id/logScroll"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@drawable/bg_log_card"
                android:padding="14dp"
                android:layout_marginTop="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="#C9B99F"
                    android:textSize="11sp"
                    android:textIsSelectable="true" />
            </ScrollView>

        </LinearLayout>
    </ScrollView>

    <!-- La interfaz real de NovaClaw (React) -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
